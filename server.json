{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.G36maid/moodle-mcp",
  "description": "Moodle LMS for LLM agents — courses, assignments, files, submissions in one static binary.",
  "version": "0.2.1",
  "website": "https://moodle.ntnu.cc",
  "repository": {
    "url": "https://github.com/G36maid/moodle-mcp",
    "source": "github"
  },
  "keywords": ["moodle", "lms", "education", "assignments", "courses"],
  "license": "MIT",
  "protocols": ["2025-06-18"],
  "capabilities": { "tools": { "listChanged": false } },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "moodle-mcp",
      "version": "0.2.1",
      "registryBaseUrl": "https://crates.io",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "MOODLE_URL",
          "description": "Your Moodle site URL, e.g. https://moodle.example.com",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "MOODLE_TOKEN",
          "description": "Web-service token from moodle-mcp auth",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
