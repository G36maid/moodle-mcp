---
/* Brand header: the real squircle icon + the "moodle -mcp" gradient wordmark
   from the banner (orange gradient / violet→sky gradient). */
const links = [
  { href: "#journey", label: "Journey" },
  { href: "#tools", label: "Tools" },
  { href: "#security", label: "Security" },
  { href: "#releases", label: "Releases" },
  { href: "/docs/", label: "Docs" },
  { href: "#about", label: "About" },
];
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="#top" aria-label="moodle-mcp home">
      <img src="/brand/moodle-mcp-icon.svg" alt="" width="26" height="26" />
      <span class="wordmark">
        <span class="w-moodle">moodle</span><span class="w-mcp">&nbsp;-mcp</span>
      </span>
    </a>

    <nav aria-label="Main">
      {
        links.map((l, i) => (
          <>
            <a href={l.href}>{l.label}</a>
            {i === 2 && <span class="divider" aria-hidden="true" />}
          </>
        ))
      }
    </nav>

    <div class="right">
      <a
        class="gh"
        href="https://github.com/G36maid/moodle-mcp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="gh-label">GitHub</span>
      </a>
      <a class="btn btn-primary" href="#install">
        Install now <span class="kbd">I</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 243, 239, 0.86);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    max-width: calc(var(--frame-max) + 2px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 56px;
    padding: 0 var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand img {
    border-radius: 6px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .w-moodle {
    background: linear-gradient(180deg, var(--orange-hi), var(--orange-lo));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .w-mcp {
    background: linear-gradient(90deg, var(--violet), var(--sky));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  nav a {
    font-size: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  nav a:hover {
    color: var(--orange-lo);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .divider {
    width: 1px;
    height: 18px;
    background: var(--line);
  }

  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .gh:hover {
    color: var(--ink-strong);
  }

  @media (max-width: 960px) {
    nav {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .gh-label {
      display: none;
    }
  }
</style>
