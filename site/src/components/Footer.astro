---
/* Footer: night-navy like the banner, gradient hairline on top,
   the real icon as watermark, and the official MCP mark. */

const cols = [
  {
    head: "Project",
    links: [
      { label: "Install", href: "#install" },
      { label: "Releases", href: "https://github.com/G36maid/moodle-mcp/releases", ext: true },
      { label: "Changelog", href: "https://github.com/G36maid/moodle-mcp/blob/main/CHANGELOG.md", ext: true },
      { label: "crates.io", href: "https://crates.io/crates/moodle-mcp", ext: true },
    ],
  },
  {
    head: "Docs",
    links: [
      { label: "Getting Started", href: "/docs/getting-started.html" },
      { label: "Configuration", href: "/docs/configuration.html" },
      { label: "Tools", href: "/docs/tools.html" },
      { label: "Security", href: "/docs/security.html" },
      { label: "About", href: "#about" },
    ],
  },
  {
    head: "Community",
    links: [
      { label: "Issues", href: "https://github.com/G36maid/moodle-mcp/issues", ext: true },
      { label: "Discussions", href: "https://github.com/G36maid/moodle-mcp/discussions", ext: true },
      { label: "MCP spec", href: "https://modelcontextprotocol.io", ext: true },
    ],
  },
];
---

<footer class="foot">
  <div class="hairline" aria-hidden="true"></div>

  <div class="cols">
    <div class="brand">
      <p class="wordmark">
        <span class="w-moodle">moodle</span><span class="w-mcp">&nbsp;-mcp</span>
      </p>
      <p class="copy">G36maid © 2026</p>
      <hr />
      <p class="fine">
        <a href="https://github.com/G36maid/moodle-mcp/blob/main/LICENSE">MIT License</a>
        <span> · </span>
        <span>Built with Astro</span>
      </p>
      <p class="fine">
        <span>Not affiliated with Moodle Pty Ltd. The Moodle name is a
        trademark of its respective owner; the MCP mark links to the official
        protocol site.</span>
      </p>
      <a
        class="mcp"
        href="https://modelcontextprotocol.io"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Built on the Model Context Protocol"
      >
        <img src="/brand/mcp-logo-dark.svg" alt="Model Context Protocol" height="14" />
      </a>
    </div>

    {
      cols.map((col) => (
        <div class="col">
          <p class="head">{col.head}</p>
          <ul>
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.ext ? "_blank" : undefined}
                  rel={l.ext ? "noopener noreferrer" : undefined}
                >
                  {l.label}
                  {l.ext && <span class="ext" aria-hidden="true">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="watermark" aria-hidden="true">
    <img src="/brand/moodle-mcp-icon.svg" alt="" width="460" height="460" />
  </div>
</footer>

<style>
  .foot {
    position: relative;
    background: var(--night);
    color: #c7cede;
    overflow: hidden;
  }

  .hairline {
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--orange),
      var(--violet) 45%,
      var(--indigo) 62%,
      var(--sky)
    );
  }

  .cols {
    position: relative;
    z-index: 1;
    max-width: calc(var(--frame-max) + 2px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    padding: 48px var(--gutter) 72px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 19px;
    margin: 0 0 6px;
  }

  .w-moodle {
    background: linear-gradient(180deg, var(--orange-hi), var(--orange-lo));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .w-mcp {
    background: linear-gradient(90deg, var(--violet), var(--sky));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .brand .copy {
    font-size: 13px;
    margin: 0;
    color: #8b95a9;
  }

  .brand hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    width: 130px;
    margin: 18px 0;
  }

  .fine {
    margin: 0 0 10px;
    font-size: 11.5px;
    line-height: 1.55;
    color: #8b95a9;
    max-width: 300px;
  }

  .fine a {
    color: inherit;
  }

  .mcp {
    display: inline-flex;
    margin-top: 10px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
  }

  .mcp img {
    height: 14px;
    width: auto;
  }

  .mcp:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .head {
    font-family: var(--font-serif);
    font-size: 15px;
    margin: 0 0 14px;
    color: #f1f4fa;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .col a {
    font-size: 12.5px;
    color: #aab4c8;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }

  .col a:hover {
    color: #fff;
  }

  .ext {
    font-size: 10px;
    margin-left: 4px;
    opacity: 0.7;
  }

  .watermark {
    position: absolute;
    right: -50px;
    bottom: -90px;
    opacity: 0.1;
    pointer-events: none;
  }

  .watermark img {
    width: 460px;
    height: auto;
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
