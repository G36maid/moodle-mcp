  <script is:inline>
    // Workflow accordion ↔ panel switcher.
    document.querySelectorAll('.wf-item').forEach((item) => {
      item.querySelector('.wf-btn').addEventListener('click', () => {
        document.querySelectorAll('.wf-item').forEach((i) => {
          i.classList.toggle('open', i === item);
          i.querySelector('.wf-btn').setAttribute('aria-selected', i === item ? 'true' : 'false');
        });
        document.querySelectorAll('.wf-panel').forEach((p) => {
          p.classList.toggle('active', p.dataset.wf === item.dataset.wf);
        });
      });
    });
  </script>
